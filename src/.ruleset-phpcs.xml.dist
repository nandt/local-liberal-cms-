<?xml version="1.0"?>
<ruleset name="Unicorn Drupal Coding Standards">
  <description>Drupal coding standards for custom code.</description>

  <file>web/modules/custom</file>
  <file>web/themes/custom</file>

  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>
  <exclude-pattern>web/modules/custom/*/build/*</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/build/*</exclude-pattern>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,yml,twig"/>
  <arg name="colors"/>
  <arg value="p"/>

  <rule ref="Drupal">
    <exclude name="Drupal.Commenting.ClassComment"/>
    <exclude name="Drupal.Commenting.DocComment"/>
    <exclude name="Drupal.Commenting.DocCommentAlignment"/>
    <exclude name="Drupal.Commenting.DocCommentLongArraySyntax"/>
    <exclude name="Drupal.Commenting.DocCommentStar"/>
    <exclude name="Drupal.Commenting.FileComment"/>
    <exclude name="Drupal.Commenting.FunctionComment"/>
    <exclude name="Drupal.Commenting.HookComment"/>
    <exclude name="Drupal.Commenting.InlineComment"/>
    <exclude name="Drupal.Commenting.VariableComment"/>
  </rule>
  <rule ref="DrupalPractice"/>
</ruleset>
