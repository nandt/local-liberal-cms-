{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./custom_packages/*",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "d3/d3",
                "version": "7.8.2",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/d3/d3",
                    "type": "git",
                    "reference": "v7.8.2"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "components/highlightjs",
                "version": "9.16.2",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/components/highlightjs",
                    "type": "git",
                    "reference": "9.16.2"
                }
            }
        }
    ],
    "require": {
        "abraham/twitteroauth": "8.1.1",
        "composer/installers": "2.3.0",
        "doctrine/collections": "^3.1",
        "drupal/admin_audit_trail": "1.0.10",
        "drupal/administerusersbyrole": "3.6.0",
        "drupal/adstxt": "1.4.0",
        "drupal/amp": "3.9.0",
        "drupal/captcha": "2.0.10",
        "drupal/consumers": "^1.24",
        "drupal/cookies": "1.2.16",
        "drupal/core-composer-scaffold": "11.4.6",
        "drupal/core-project-message": "11.4.6",
        "drupal/core-recommended": "11.4.6",
        "drupal/critical_css": "2.0.3",
        "drupal/ctools": "4.1.0",
        "drupal/decoupled_router": "^2.0",
        "drupal/devel": "5.5.0",
        "drupal/google_tag": "2.0.9",
        "drupal/health_check": "3.1.0",
        "drupal/image_effects": "5.0.0",
        "drupal/jquery_ui": "1.8.0",
        "drupal/jquery_ui_datepicker": "2.1.1",
        "drupal/jsonapi_extras": "3.28.0",
        "drupal/jsonapi_image_styles": "^3.0",
        "drupal/jsonapi_include": "2.0.0",
        "drupal/jsonapi_menu_items": "^1.2",
        "drupal/jsonapi_resources": "^1.7",
        "drupal/klaro": "3.1.0",
        "drupal/mail_login": "^4.2",
        "drupal/message": "1.8.0",
        "drupal/metatag": "2.2.0",
        "drupal/pager_serializer": "1.3.0",
        "drupal/pathauto": "1.15.0",
        "drupal/purge": "3.6.0",
        "drupal/raven": "7.4.0",
        "drupal/recaptcha": "3.4.0",
        "drupal/redirect": "1.13.0",
        "drupal/redis": "1.11.0",
        "drupal/restui": "1.22.0",
        "drupal/robotstxt": "1.6.0",
        "drupal/s3fs": "3.11.0",
        "drupal/scheduler": "2.3.0",
        "drupal/schema_metatag": "3.0.4",
        "drupal/search_api": "1.41.0",
        "drupal/search_api_solr": "4.3.10",
        "drupal/simple_cron": "1.1.0",
        "drupal/simple_oauth": "^6.1",
        "drupal/simple_oauth_password_grant": "^2.1",
        "drupal/statistics": "1.0.1",
        "drupal/subrequests": "^3.0",
        "drupal/taxonomy_import": "2.1.1",
        "drupal/token": "1.17.0",
        "drupal/varnish_purge": "2.3.0",
        "drupal/view_unpublished": "1.3.0",
        "drupal/views_bulk_operations": "4.4.5",
        "drupal/views_custom_cache_tag": "1.5.0",
        "drupal/warmer": "2.0.14",
        "drush/drush": "^13",
        "gravitypdf/querypath": "4.2.0",
        "guzzlehttp/guzzle": "^7.10",
        "symfony/property-access": "^8.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/development.services.yml": false,
                "[web-root]/.htaccess": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "drupal/coder": "^9.0",
        "drupal/openapi_jsonapi": "^3.0",
        "drupal/openapi_ui_swagger": "^1.2",
        "mglaman/phpstan-drupal": "^2.0",
        "palantirnet/drupal-rector": "^1.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.5"
    },
    "scripts": {
        "cs:fix": "vendor/bin/phpcbf --standard=.ruleset-phpcs.xml.dist --colors",
        "cs:check": "vendor/bin/phpcs --standard=.ruleset-phpcs.xml.dist --colors",
        "rector": "./vendor/bin/rector process --config=.ruleset-rector.php --ansi --memory-limit=2G",
        "phpstan": "./vendor/bin/phpstan analyse -c .ruleset-phpstan.neon --ansi --memory-limit=2G",
        "cmp-update": [
            "composer update",
            "./vendor/bin/drush -y updb",
            "./vendor/bin/drush cr"
        ],
        "clear-registry": [
            "./vendor/bin/drush cr"
        ]
    }
}
