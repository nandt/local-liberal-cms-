      "teleutaia_enhmerosh" => t("teleutaia_enhmerosh"),
    ];

    $page['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'script',
        '#value' => "window.stocks_translations = " . json_encode($stocks_translations, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE),
      ],
      'liberal_custom_content/stocks_app_translations',
    ];

  }
}

function liberal_custom_content_views_pre_render(ViewExecutable $view): void {

  // change the title of the page dynamically according to the search filter
  if ($view->id() == 'search_solr' && $view->current_display == 'page_1') {
    $exposed_input = $view->getExposedInput();
    $search_filter = $exposed_input['search_keys'] ?? '';
    $view->setTitle(t('Search for ') . $search_filter);
  }
}

function liberal_custom_content_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  // check if the form is a Views exposed form.
  if (str_contains((string) $form_id, 'views_exposed_form') && isset($form['search_keys'])) {
    // add placeholder
    $form['search_keys']['#attributes']['placeholder'] = t('Αναζήτηση στο liberal.gr');
    $form['search_keys']['#type'] = 'search';
  }
}

/**
 * Implements hook_views_pre_view().
 * @param array<int, mixed> $args
 */
function liberal_custom_content_views_pre_view(ViewExecutable $view, $display_id, array &$args): void {

  if (in_array($view->id(), liberalCustomContentUtils::feedPagesViewIds)
      && $view->current_display == 'default') {

    $search_input_date = $args[0];

    if ($search_input_date instanceof Datetime) {
      $display = $view->getDisplay();
      $filters = $display->getOption('filters');

      $search_start_date = $search_input_date->modify('today')->format('Y-m-d H:i:s');
      liberalCustomContentUtils::getEoDayDatetime($search_input_date);
      $search_end_date = $search_input_date->format('Y-m-d H:i:s');

      // get beginning and end of day from argument date
      $filters['created']['value']['min'] = $search_start_date;
      $filters['created']['value']['max'] = $search_end_date;
      $display->overrideOption('filters', $filters);
    }
  }

  // Trick views into thinking that the exposed form must be rendered
  if ($view->id() == 'search_solr' && $view->current_display == 'page_1') {
    $display = $view->getDisplay();
    $display->setOption('exposed_block', FALSE);
  }

  if ($view->id() == 'category') {
    // apply to all display_ids
    if (in_array($args[0], array_keys(liberalCustomContentUtils::taxonomyLiberalHasChildren))) {
      $cid = 'liberalchildcats:' . $args[0];

      // Get the filter handler for the contextual filter.
      $filter = $view->display_handler->getHandler('argument', 'tid');

      // Set the filter to allow multiple values.
      if (!empty($filter)) {
        // cache the results for 24 hours then auto-expire
        if ($cache = \Drupal::cache()->get($cid)) {
          $results = $cache->data;
        }
        else {
          $connection = \Drupal::database();
          $query = $connection->select('taxonomy_term__parent', 'ttp')
            ->fields('ttp', ['entity_id', 'bundle'])
            ->condition('parent_target_id', $args[0], '=');

          $executed = $query->execute();

          // Get all the results
          $results = $executed->fetchAllAssoc('entity_id');

          \Drupal::cache()
            ->set(
                $cid,
                $results,
                Drupal::time()->getRequestTime() + 86400
            );
        }

        $filter->options['break_phrase'] = TRUE;
        $filter->options['validate_options']['multiple'] = 1;

        // set the title using our const for these categories
        $filter->options['title'] = liberalCustomContentUtils::taxonomyLiberalHasChildren[$args[0]];

        if (!empty($results)) {
          $args[0] = $args[0] . '+' . implode('+', array_keys($results));
        }
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 * @param array<string, mixed> $variables
*/
function liberal_custom_content_theme_suggestions_field_alter(array &$suggestions, array $variables): void {
  if ($variables['element']['#bundle'] == "article_liberal"
  && $variables['element']['#field_name'] == "field_homepage_bullets"
  && ($variables['element']['#view_mode'] == "full" || $variables['element']['#view_mode'] == "amp")) {
    $suggestions[] = 'field__article_read_more';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 * @param array<string, mixed> $variables
*/
function liberal_custom_content_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  if ($variables['elements']['#node']->getType() == 'article_liberal'
      && $variables['elements']['#view_mode'] == "read_more") {
    $suggestions[] = 'node__article_read_more';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
*/
function liberal_custom_content_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($node instanceof NodeInterface && $route_name == 'entity.node.canonical') {
    $suggestions[] = 'page__' . $node->bundle();

    $is_advertising_article = liberalCustomContentUtils::checkIfNodeIsAdvertising($node);

    if ($is_advertising_article) {
      $suggestions[] = 'page__advertising_article';
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 * @param array<string, mixed> $variables
*/
function liberal_custom_content_theme_suggestions_region_alter(array &$suggestions, array $variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($variables['elements']['#region'] == 'header' &&
    $node instanceof NodeInterface && $route_name == 'entity.node.canonical') {
    $is_advertising_article = liberalCustomContentUtils::checkIfNodeIsAdvertising($node);

    if ($is_advertising_article) {
      $suggestions[] = 'region__header__advertising_article';
    }
  }
}

/**
 * Implements hook_entity_view_mode_alter().
 */
function liberal_custom_content_entity_view_mode_alter(&$view_mode, EntityInterface $entity, $context): void {

  // AMP modules has the same hook so we execute ours last so we avoid interfering with the view mode
  if ($entity instanceof NodeInterface && ($view_mode == 'full' || $view_mode == 'amp')) {
    $is_advertising_article = liberalCustomContentUtils::checkIfNodeIsAdvertising($entity);

    // when it's an advertising article instead of full swap to advertising_article
    if ($is_advertising_article) {
      switch ($view_mode) {
        case 'full':
          $view_mode = 'advertising_article';
          break;

        case 'amp':
          $view_mode = 'amp_advertising_article';
          break;
      }
    }
  }
}

/**
 * Implementation of hook_ENTITY_TYPE_view_alter();
 * @param array<string, mixed> $build
 */
function liberal_custom_content_node_view_alter(array &$build, NodeInterface $node, EntityViewDisplayInterface $display): void {
  $type = $node->getType();

  // create the oblation url field
  if ((in_array($build['#view_mode'], ['full', 'advertising_article', 'amp', 'amp_advertising_article']))
      && in_array($type, ['article_liberal', 'podcast'])) {

    $options = ['absolute' => TRUE];
    $node_url = Url::fromRoute('entity.node.canonical', ['node' => $node->id()], $options);
    $node_url_str = $node_url->toString();

    // facebook messenger share
    $build['liberal_node_url'] = [
      '#markup' => $node_url_str,
      '#cache' => [
        'max-age' => -1,
      ],
    ];

    if ($build['#view_mode'] != 'amp' && $build['#view_mode'] != 'amp_advertising_article') {
      $config = \Drupal::config('liberal_socials_post.settings');
      $facebook_app_id = $config->get('facebook_app_id_1');

      $facebook_messenger_params = [
        'app_id' => $facebook_app_id,
        'link' => $node_url_str,
        'redirect_uri' => $node_url_str,
      ];

      $facebook_messenger_params_mobile = [
        'app_id' => $facebook_app_id,
        'link' => $node_url_str,
      ];

      // facebook messenger share
      $build['liberal_fb_messenger'] = [
        '#desktop' => Url::fromUri('http://www.facebook.com/dialog/send', ['query' => $facebook_messenger_params])->toString(),
        '#mobile' => 'fb-messenger://share/?' . http_build_query($facebook_messenger_params_mobile),
        '#cache' => [
          'max-age' => -1,
        ],
      ];
    }

    if (isset($node->field_oblation_category->target_id)) {

      $oblation_id = $node->field_oblation_category->target_id;
      $oblation_url = Url::fromUri('internal:/oblation/' . $oblation_id);
      $oblation_title = $build['field_oblation_category'][0]['#title'];

      // add cache max-age -1 like all other fields have
      $oblation_link = [
        '#type' => 'link',
        '#title' => Markup::create($oblation_title),
        '#url' => $oblation_url,
        '#cache' => [
          'max-age' => -1,
        ],
      ];

      // Replace the original link field with the modified render array.
      $build['liberal_oblation_link'] = $oblation_link;
    }
  }

  // Apopsi view mode
  if ($build['#view_mode'] == 'apopsi' && in_array($type, ['article_liberal', 'podcast'])) {

    $apopseis_settings = \Drupal::config('liberal_custom_content.apopseis_settings')->get();

    if (isset($node->view) && $node->view instanceof ViewExecutable) {
      $view_id = $node->view->id();
    }

    $node_settings = $apopseis_settings[$view_id . '_fieldset'] ?? NULL;

    if (isset($node_settings) && $node_settings['apopseis_region_option'] == "category") {
      $ap_name = $node_settings['apopseis_region_name'];
      $ap_surname = $node_settings['apopseis_region_surname'];
      $ap_file = is_array($node_settings['file']) ? array_shift($node_settings['file']) : "";
      $ap_url = Url::fromRoute("entity.taxonomy_term.canonical", ["taxonomy_term" => $node_settings['apopseis_region']])->toString();
      $build['#cache']['tags'][] = "config:liberal_custom_content.apopseis_settings";

      // Load the image style url for author
      if (is_array($ap_file) && !empty($ap_file)) {
        $style = ImageStyle::load('liberal_author_image');
        // initialize value to prevent warning even with
        $ap_style_url = '';
        $apopseis_fid = array_shift($ap_file);

        if (!empty($style) && isset($apopseis_fid)) {
          $apopseis_uri = File::load($apopseis_fid);
          $ap_style_url = $style->buildUrl($apopseis_uri->getFileUri());
        }
      }
    }
    else {
      $author_obj = $node->field_arthrografos?->target_id ? Term::load($node->field_arthrografos->target_id) : NULL;
      $build['#cache']['tags'][] = "config:liberal_custom_content.apopseis_settings";

      if ($author_obj instanceof TermInterface) {
        // Load the image style url for author
        $style = ImageStyle::load('liberal_author_image');
        // initialize value to prevent warning even with
        $ap_style_url = '';
        $author_pic_fid = $author_obj->field_author_profile->target_id;

        if (!empty($style) && isset($author_pic_fid)) {
          $author_pic_uri = File::load($author_pic_fid)->getFileUri();
          $ap_style_url = $style->buildUrl($author_pic_uri);
        }

        $ap_name = $author_obj->field_author_firstname->value;
        $ap_surname = $author_obj->field_author_lastname->value;
        $ap_url = Url::fromRoute("entity.taxonomy_term.canonical", ["taxonomy_term" => $author_obj->id()])->toString();
        $build['#cache']['tags'][] = "taxonomy_term:" . $author_obj->id();
      }
    }

    if (!empty($ap_name)) {
      $build['liberal_author_firstname'] = [
        '#cache' => [
          'max-age' => -1,
        ],
        '#markup' => Html::escape($ap_name),
      ];
    }

    if (!empty($ap_surname)) {
      $build['liberal_author_lastname'] = [
        '#cache' => [
          'max-age' => -1,
        ],
        '#markup' => Html::escape($ap_surname),
      ];
    }

    $build['liberal_author_url'] = [
      '#cache' => [
        'max-age' => -1,
      ],
      '#markup' => $ap_url ?? "",
    ];

    // only add an image if there is actually one
    if (!empty($ap_style_url)) {
      $build['liberal_author_pic'] = [
        '#cache' => [
          'max-age' => -1,
        ],
        '#markup' => $ap_style_url ?? "",
      ];
    }

    $body = $node->get('body');
    $summary = $body->summary;

    $build['liberal_body_summary'] = [
      '#cache' => [
        'max-age' => -1,
      ],
      '#markup' => Xss::filter($summary),
    ];
  }

  // if view mode is not full or amp then only print 2 values of homebullet field
  if ((in_array($type, ['article_liberal', 'podcast']))
    && $build['#view_mode'] != 'advertising_article'
    && !in_array($build['#view_mode'], liberalCustomContentUtils::readMoreOnlyInViewModes)) {
    if (isset($build['field_homepage_bullets']['#items'])) {
      $items = $build['field_homepage_bullets']['#items']->getValue();
      $count_items = count($items);

      if (!empty($items) && $count_items > liberalCustomContentUtils::readMoreBulletValues) {
        // perhaps also remove the items from the field list but for the purposes of printing this is not needed
        for ($i = 0; $i < $count_items; $i++) {
          if ($i < liberalCustomContentUtils::readMoreBulletValues) {
            continue;
          }
          if (isset($build['field_homepage_bullets'][$i])) {
            unset($build['field_homepage_bullets'][$i]);
          }
        }
      }
    }
  }

  /*
   * Add the img url for impressions if it has value
   * and we are in frontpage or read more
   */
  if (in_array($type, ['article_liberal', 'podcast'])) {
    $is_front = \Drupal::service('path.matcher')->isFrontPage();

    if (in_array($build['#view_mode'], liberalCustomContentUtils::printImpressionsImageViewModes) || $is_front) {

      /*
       * if at homepage and the article also has bullets
       * then add the impressions img tag if it exists
       */
      if (isset($build['field_homepage_bullets']['#items']) && $is_front) {
        $bullet_children = Element::children($build['field_homepage_bullets']);

        if (!empty($bullet_children)) {
          foreach ($bullet_children as $bullet_child) {
            if (isset($build['field_homepage_bullets'][$bullet_child]['#entity']->field_kodikas_impression_image->value)) {
              // use a post render function to append the html of the img tag to the field value
              $build['field_homepage_bullets'][$bullet_child]['#post_render'][] = [liberalImpressionsRender::class, 'addImpressionsImage'];
            }
          }
        }
      }

      if (isset($node->field_kodikas_impression_image->value)) {
        $build['liberal_impression_image'] = [
          '#cache' => [
            'max-age' => -1,
          ],
          '#weight' => -9999,
          '#markup' => $node->field_kodikas_impression_image->value,
        ];
      }
    }
  }

  // only for amp pages, only act when we should show ads
  if ($build['#view_mode'] == 'read_more' && ($type == 'article_liberal' || $type == 'podcast')) {

    // if image exists, then set alt and title to title of node
    if (!empty($node->field_kentriki_fotografia->target_id)
      && !empty($build['field_kentriki_fotografia']['#formatter'])
      && ($build['field_kentriki_fotografia']['#formatter'] == "image"
      || $build['field_kentriki_fotografia']['#formatter'] == "amp_image")) {

      $img_attributes = [
        'class' => ['article_read_more__item__image', 'object-fit-cover'],
      ];

      $kentriki_image_vals = $build['field_kentriki_fotografia']['0']['#item']->getValue();
      $kentriki_image_vals['alt'] = $node->getTitle();
      $kentriki_image_vals['title'] = $node->getTitle();
      $kentriki_image_vals['width'] = 135;
      $kentriki_image_vals['height'] = 90;
      $build['field_kentriki_fotografia']['0']['#item']->setValue($kentriki_image_vals);

      // if active theme is amp, then change the formatter by hand

      if (isset($build['field_kentriki_fotografia']['0']['#item_attributes']) &&
        is_array($build['field_kentriki_fotografia']['0']['#item_attributes'])) {
        $build['field_kentriki_fotografia']['0']['#item_attributes'] += $img_attributes;
      }
      else {
        $build['field_kentriki_fotografia']['0']['#item_attributes'] = $img_attributes;
      }
    }
  }
}

function liberal_custom_content_critical_css_file_paths_suggestion_alter(array &$file_paths, $entity): void {
  // if advertising article then add own critical css
  if ($entity instanceof NodeInterface
    && $entity->bundle() == 'article_liberal'
    && isset($entity->field_eidos_arthrou->target_id)) {
    $eidos_arthrou = $entity->field_eidos_arthrou->target_id;
    $advertising_article_id = liberalCustomContentUtils::getArticleTypeAdvertisingTid();
    $active_theme = \Drupal::theme()->getActiveTheme()->getName();

    if ($eidos_arthrou == $advertising_article_id) {
      array_unshift($file_paths, 'themes/custom/' . $active_theme . '/critical-css/advertising_article.css');
    }
  }
}

/**
 * Implements hook_entity_update().
 */
function liberal_custom_content_entity_update(EntityInterface $entity): void {
  /* only when a node is unpublished aka Draft.
  This hook needs to execute before the one of pathauto.
   */
  if ($entity instanceof NodeInterface) {
    // if the node is unpublished still, or if it was unpublished and now it's published
    if ((!$entity->isPublished() || ($entity->isPublished() && !$entity->getOriginal()->isPublished()))
        && in_array($entity->bundle(), ['article_liberal', 'podcast'])) {

      $categories = $entity->get('field_liberal_category')->first()?->getValue();
      $original_categories = $entity->getOriginal()->get('field_liberal_category')->first()?->getValue();

      // only act if title or category changes. Otherwise the alias won't change anyway
      if ($entity->getTitle() != $entity->getOriginal()->getTitle()
        || $categories != $original_categories) {

        $path_alias_manager = \Drupal::entityTypeManager()->getStorage('path_alias');
        $alias_objects = $path_alias_manager->loadByProperties([
          'path' => '/node/' . $entity->id(),
        ]);

        // delete all aliases / languages
        foreach ($alias_objects as $alias) {
          $alias->delete();
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_html()
 */
function liberal_custom_content_preprocess_html(&$variables): void {

  if (strcasecmp(getenv("NO_INDEX"), "true") == 0) {
    $robots_meta = [
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'robots',
        'content' => 'noindex, nofollow',
      ],
    ];

    $variables['page']['#attached']['html_head'][] = [$robots_meta, 'robots'];
  }
}

function liberal_custom_content_module_implements_alter(&$implementations, $hook): void {
  if ($hook == 'entity_update') {
    $group = $implementations['liberal_custom_content'];
    unset($implementations['liberal_custom_content']);
    $implementations = ['liberal_custom_content' => $group] + $implementations;
  }

  if ($hook == 'entity_view_mode_alter') {
    unset($implementations['liberal_custom_content']);
    $implementations['liberal_custom_content'] = 'liberal_custom_content';
  }
}

// Control the visibility of certain blocks programmatically
function liberal_custom_content_block_access(Block $block, $operation, AccountInterface $account) {

  if (($block->id() == 'footer'
    || $block->getPluginId() == 'views_exposed_filter_block:search_solr-page_1')
    && $operation == 'view') {

    $node = \Drupal::routeMatch()->getParameter('node');

    if ($node instanceof NodeInterface) {
      $is_advertising_article = liberalCustomContentUtils::checkIfNodeIsAdvertising($node);

      // hide footer block and search
      if ($is_advertising_article) {
        return AccessResult::forbidden()
          ->addCacheableDependency($block);
      }
    }
  }

  // No opinion. Defer judgement to other function
  return AccessResult::neutral();
}

/**
 * @param array<string, mixed> $form
 */
function liberal_custom_content_form_contact_message_epikoinonia_form_alter(array &$form, FormStateInterface $form_state): void {
  array_splice($form['actions']['submit']['#submit'], 1, 0, [
    function (array &$form, FormStateInterface $form_state): void {
      $form_state->getFormObject()->getEntity()->set('subject', '');
    },
  ]);
}
