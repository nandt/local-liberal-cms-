/**
 * Implements hook_metatags_alter().
 */

define('ROH_EIDISEON', 1);

/**
 * @param array<string, mixed> $metatags
 * @param array<string, mixed> $context
 */
function liberal_custom_content_metatags_alter(array &$metatags, array $context): void {

  // Check for a node.
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    // Run code only for liberal article node type
    $type = $node->getType();

    if ($type == 'article_liberal') {
      // context is a node object at this point
      $existing_image = $context['entity']->get('field_kentriki_fotografia')->getValue();

      // if there is no image for the article, replace with image from category
      if (empty($existing_image)) {
        $metatags['og_image'] = "[node:field_liberal_category:0:entity:field_metatag_image]";
        $metatags["twitter_cards_image"] = "[node:field_liberal_category:0:entity:field_metatag_image]";

        // replace the image with category if it doesn't exist for schema. Set already serialized value
        $metatags["schema_article_image"] = 'a:4:{s:5:"@type";s:11:"ImageObject";s:3:"url";s:69:"[node:field_liberal_category:0:entity:field_metatag_image:entity:url]";s:5:"width";s:64:"[node:field_liberal_category:0:entity:field_metatag_image:width]";s:6:"height";s:65:"[node:field_liberal_category:0:entity:field_metatag_image:height]";}';
      }

      // add hypertitle to the metatags if not empty
      $hypertitle = $node->get('field_subtitle')->value;

      // check if hypertitle exists and embed to message
      if (!empty($hypertitle)) {
        $hypertitle_text = "[node:field_subtitle:value] - ";
        $metatags['og_title'] = $hypertitle_text . $metatags['og_title'];
        $metatags["twitter_cards_title"] = $hypertitle_text . $metatags["twitter_cards_title"];
      }
    }
  }
}

/**
 * Implements hook_taxonomy_term_insert()
 */

function liberal_custom_content_taxonomy_term_insert(TermInterface $term): void {

  // create alias when new oblation is created
  if ($term->bundle() == 'oblations') {
    $base_oblation_url = '/oblation/';

    if (!empty($base_oblation_url)) {
      // run the pathauto functions to clean the string first
      $cleanTitle = \Drupal::service("pathauto.alias_cleaner")->cleanString($term->label());

      $alias = '/oblation/' . $cleanTitle;
      $alias = \Drupal::service("pathauto.alias_cleaner")->cleanAlias($alias);

      $path_alias = PathAlias::create([
        'path' => $base_oblation_url . $term->id(),
        'alias' => $alias,
      ]);

      $path_alias->save();
    }
  }
}

/**
 * Implements hook_node_delete()
 */

function liberal_custom_content_taxonomy_term_delete(TermInterface $term): void {

  // delete path alias when oblation is deleted
  if ($term->bundle() == 'oblations') {
    $path_alias_manager = \Drupal::entityTypeManager()->getStorage('path_alias');
    $alias_objects = $path_alias_manager->loadByProperties([
      'path' => '/oblation/' . $term->id(),
    ]);

    // delete all aliases / languages
    foreach ($alias_objects as $alias) {
      $alias->delete();
    }
  }
}

/**
 * Implements hook_node_presave()
 */

function liberal_custom_content_node_presave(NodeInterface $node): void {

  if (in_array($node->bundle(), ['article_liberal', 'podcast'])) {
    // find all the enabled apopseis and check what we need to clear
    $article_category = $node->get('field_liberal_category')?->target_id;

    if (!empty($article_category)) {
      liberalCustomContentUtils::clearApopseisCache($article_category);
    }

    // construct the cache tags and send it for clearing
    $categories_cache_tags = liberalCustomContentUtils::createTaxonomiesCacheTags($node);
    if (!empty($categories_cache_tags)) {
      liberalCustomContentUtils::clearTaxonomies($categories_cache_tags);
    }

    if ($node->isNew()) {
      $categories = $node->get('field_liberal_category')->getValue();
      $block_flags = $node->get('field_block_flag')->getValue();

      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
        ->loadByProperties(['name' => 'LIVE Χρηματιστήριο', 'vid' => 'category']);
      $term = reset($term);
      $exclude_cat = $term->id();
      $set_flag = TRUE;

      foreach ($categories as $category) {
        if ($category['target_id'] == $exclude_cat) {
          $set_flag = FALSE;
        }
      }

      // if it exists already for some reason dont append again so flag it false
      foreach ($block_flags as $block_flag) {
        if ($block_flag['value'] == ROH_EIDISEON) {
          $set_flag = FALSE;
        }
      }

      if ($set_flag) {
        $node->get('field_block_flag')->appendItem(['value' => ROH_EIDISEON]);
      }
    }
  }
}

/**
 * Alter the meta tags for any page prior to page attachment.
 *
 * @param array<string, mixed> $metatag_attachments
 *   An array of metatag objects to be attached to the current page.
 */
function liberal_custom_content_metatags_attachments_alter(array &$metatag_attachments): void {

  // Get current route object.
  $route_match = \Drupal::routeMatch();
  $route = $route_match->getRouteObject();
  $route_name = $route_match->getRouteName();
  $node = $route_match->getParameter('node');

  if ($route) {
    $view_id = $route->getDefault('view_id');
    if (!empty($view_id)) {

      // stocks / index
      if ($view_id == 'live_ase_market_stock_internal_page'
      || $view_id == 'live_ase_market_index_internal_page') {

        $stc_idx_page = TRUE;
        $vid = '';

        $current_path = \Drupal::service('path.current')->getPath();
        $title_inserted = [];
        $arg = explode('/', $current_path);

        // get the stock or index
        switch ($view_id) {
          case 'live_ase_market_stock_internal_page':
            $vid = 'metohes';
            $query_field = 'field_stc_symbol_en';
            $tax_field = 'field_stc_company_name';
            $text = "της μετοχής";
            $text_title = "Τιμή Μετοχής ";
            break;

          case 'live_ase_market_index_internal_page':
            $vid = 'indices';
            $query_field = 'field_ase_idx_symbol_en';
            $tax_field = 'field_ase_idx_company_name';
            $text = "του δείκτη";
            $text_title = "Τιμή Δείκτη ";
            break;
        }

        $term_result = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
          $query_field => $arg['3'],
          'vid' => $vid,
        ]);

        if (!empty($term_result)) {
          $term = array_shift($term_result);

          $name = $term->label();
          $company_name = $term->{$tax_field}->value;

          $metatag_attachments['#attached']['html_head'][] = [
            [
              '#tag' => 'meta',
              '#attributes' => [
                'name' => 'description',
                'content' => "Η τιμή " . $text . " " . $company_name . ", " . "με κωδικό χρηματιστηρίου " . $name . ". Σε ζωντανή ενημέρωση.",
              ],
            ],
            'description',
          ];
        }
      }
    }
  }

  // code for all pages, preserve the title
  foreach ($metatag_attachments['#attached']['html_head'] as $key => $metatag_attachment) {
    // preserve the title meta tag to be printed by changing the key
    if ($metatag_attachment[1] == 'title') {

      if (isset($stc_idx_page) && isset($term)) {
        $metatag_attachments['#attached']['html_head'][$key] = [
          [
            '#tag' => 'meta',
            '#attributes' => [
              'name' => 'title',
              'content' => $text_title . $name . ", " . $company_name . " | " . \Drupal::token()->replace("[site:name]"),
            ],
          ],
          'title',
        ];
      }

      // copy the title into another element with different key so it will be printed
      $title_inserted = $metatag_attachments['#attached']['html_head'][$key];
      $title_inserted['1'] = 'liberal_preserve_title';
      $title_inserted_key = $key;

      // insert after the 1st occurance
      if (isset($title_inserted_key)) {
        array_splice($metatag_attachments['#attached']['html_head'], $title_inserted_key, 0, [$title_inserted]);
      }

      break;
    }
  }

  // add facebook app id meta to the pages we need
  if (($node instanceof NodeInterface
    && in_array($node->bundle(), ['article_liberal', 'podcast'])) || $route_name == 'view.oblation_microsite.page') {
    $config_facebook = \Drupal::config('liberal_socials_post.settings');
    $fb_app_id = $config_facebook->get('facebook_app_id_1');

    $metatag_attachments["#attached"]["html_head"][] = [
      0 => [
        '#tag' => "meta",
        '#attributes' => [
          'property' => 'fb:app_id',
          'content' => $fb_app_id,
        ],
      ],
      1 => 'liberal_fb_app_id',
    ];
  }

  if ($node instanceof NodeInterface
        && in_array($node->bundle(), ['article_liberal', 'podcast'])) {

    // see if there is an author, if not change to LiberalNewsRoom without url
    foreach ($metatag_attachments['#attached']['html_head'] as $key => $metatag_attachment) {

      /* Works in conjuction with τηε setting in Drupal. You can set 2 values
      comma separated and if the first value is empty, the second is used */
      if ($metatag_attachment[1] == 'schema_article_author_0') {
        $author_name = $metatag_attachment[0]['#attributes']['content']['name'];
        if (empty($author_name[0])) {
          $author_name_print = $author_name[1];
        }
        else {
          $author_name_print = $author_name[0];
        }

        $metatag_attachments['#attached']['html_head'][$key][0]['#attributes']['content']['name'] = $author_name_print;
      }

      // main article of entity page overwrite
      if ($metatag_attachment[1] == "schema_article_main_entity_of_page") {
        // new attributes
        $main_entity_page = [
          '@type' => 'Webpage',
          '@id' => $metatag_attachment[0]['#attributes']['content'],
        ];

        $metatag_attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = $main_entity_page;
      }

      // social meta, inject this tag near the other twitter tags
      if (str_starts_with((string) $metatag_attachment[1], 'twitter_cards') && !isset($flag_twitter_site)) {
        $twitter_site = [
          0 => [
            '#tag' => "meta",
            '#attributes' => [
              'name' => 'twitter:site',
              'content' => '@LiberalGr',
            ],
          ],
          1 => 'liberal_twitter_cards_site',
        ];

        $flag_twitter_key = $key;
        $flag_twitter_site = TRUE;
      }
    }

    // insert after the 1st occurance
    if (isset($flag_twitter_key)) {
      array_splice($metatag_attachments["#attached"]["html_head"], $flag_twitter_key + 1, 0, [$twitter_site]);
    }

    // Keywords field
    $tag_ids = $node->field_liberal_tags->getValue();

    if (!empty($tag_ids)) {
      $tag_ids = array_column($node->field_liberal_tags->getValue(), 'target_id');

      $loaded_tags = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple($tag_ids);
      $tags = [];

      foreach ($loaded_tags as $loaded_tag) {
        $tags[] = $loaded_tag->label();
      }

      $metatag_attachments["#attached"]["html_head"][] = [
        0 => [
          '#tag' => "meta",
          '#attributes' => [
            'name' => 'keywords',
            'content' => implode(',', $tags),
            'group' => 'schema_article',
            'schema_metatag' => TRUE,
          ],
        ],
        1 => 'liberal_schema_article_keywords',
      ];
    }
    if ($node->bundle() === 'podcast') {
      if (isset($metatag_attachments['#attached']['html_head'])) {
        foreach ($metatag_attachments['#attached']['html_head'] as $key => $tag) {
          if (isset($tag[1]) && $tag[1] === 'schema_article_type') {
            $metatag_attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = 'VideoObject';
          }
        }

        $duration = $node->field_podcast_duration->getValue();
        $metatag_attachments["#attached"]["html_head"][] = [
          [
            '#tag' => "meta",
            '#attributes' => [
              'name' => 'duration',
              'content' => LiberalPodcastDurationUtility::getDuration($duration[0]['value'] ?? 0),
              'group' => 'schema_article',
              'schema_metatag' => TRUE,
            ],
          ], 'liberal_podcast_duration',
        ];

        $embed_field = $node->field_podcast_source_code->getValue();
        $embed_html = $embed_field[0]['value'] ?? '';
        if (preg_match('/<iframe[^>]+src=["\']([^"\']+)["\']/i', $embed_html, $matches)) {
          $embed_url = $matches[1];
          $iframe_url = strtok($matches[1], '?');
        }

        if (str_contains($embed_url, 'cloudflarestream.com')) {

          if (preg_match('/cloudflarestream\.com\/([^\/]+)\//', $iframe_url, $id_match)) {
            $video_id = $id_match[1];
            $media_video['url'] = "https://videodelivery.net/$video_id/manifest/video.m3u8";

            $metatag_attachments["#attached"]["html_head"][] = [
              [
                '#tag' => "script",
                '#attributes' => [
                  'name' => 'contentUrl',
                  'content' => $media_video['url'],
                  'group' => 'schema_article',
                  'schema_metatag' => TRUE,
                ],
              ],
              'liberal_podcast_contentUrl',
            ];
          }
        }
        $metatag_attachments["#attached"]["html_head"][] = [
          [
            '#tag' => "meta",
            '#attributes' => [
              'name' => 'embedUrl',
              'content' => strtok($embed_url, '?'),
              'group' => 'schema_article',
              'schema_metatag' => TRUE,
            ],
          ],
          'liberal_podcast_source_code',

        ];

        $hypertitle = $node->field_subtitle->getValue();
        $hypertitle_name = $hypertitle[0]['value'] ?? '';
        $hypertitle_name = trim(strip_tags($hypertitle_name));
        $title = $node->getTitle();
        $about = [
          "@type" => "Thing",
          "name" => $hypertitle_name ? "{$hypertitle_name} : {$title}" : $title,
        ];
        $metatag_attachments["#attached"]["html_head"][] = [
          [
            '#tag' => "meta",
            '#attributes' => [
              'name' => 'about',
              'content' => $about,
              'group' => 'schema_article',
              'schema_metatag' => TRUE,
            ],
          ],
          'liberal_podcast_about',
        ];

        $podcast_category = $node->field_liberal_category->getValue();
        $term = '';
        if (!empty($podcast_category)) {
          $first_category = reset($podcast_category);
          if (!empty($first_category['target_id'])) {
            $term = Term::load($first_category['target_id']);
          }
        }
        if ($term) {
          $metatag_attachments["#attached"]["html_head"][] = [
            [
              '#tag' => "meta",
              '#attributes' => [
                'name' => 'genre',
                'content' => $term->getName(),
                'group' => 'schema_article',
                'schema_metatag' => TRUE,
              ],
            ],
            'liberal_podcast_genre',
          ];
        }
        $language = 'el';
        $metatag_attachments["#attached"]["html_head"][] = [
          ['#tag' => "meta",
            '#attributes' => [
              'name' => 'inLanguage',
              'content' => $language,
              'group' => 'schema_article',
              'schema_metatag' => TRUE,
            ],
          ], 'liberal_podcast_language',
        ];
      }
    }
    if ($node->bundle() === 'article_liberal') {

      $liberal_category = $node->field_liberal_category->getValue();

      if (!empty($liberal_category)) {
        $liberal_category = reset($liberal_category);
        $loaded_category = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($liberal_category['target_id']);

        $metatag_attachments["#attached"]["html_head"][] = [
          [
            '#tag' => "meta",
            '#attributes' => [
              'name' => 'articleSection',
              'content' => $loaded_category->label(),
              'group' => 'schema_article',
              'schema_metatag' => TRUE,
            ],
          ],
          'liberal_schema_article_article_section',
        ];
      }

      $body_value = $node->body->value ?? '';
      $metatag_attachments["#attached"]["html_head"][] = [
        [
          '#tag' => "meta",
          '#attributes' => [
            'name' => 'articleBody',
            'content' => strip_tags($body_value),
            'group' => 'schema_article',
            'schema_metatag' => TRUE,
          ],
        ],
        'liberal_schema_article_article_body',
      ];
    }
    $metatag_attachments["#attached"]["html_head"][] = [
      [
        '#tag' => "meta",
        '#attributes' => [
          'name' => 'type',
          'content' => 'article',
        ],
      ],
      'liberal_meta_tyoe_article',
    ];

    $metatag_attachments["#attached"]["html_head"][] = [
      [
        '#tag' => "meta",
        '#attributes' => [
          'property' => 'article:publisher',
          'content' => 'https://www.facebook.com/liberalgr',
        ],
      ],
      'liberal_article_publisher',
    ];
  }
}

/**
 * Implements hook_metatag_route_entity()
 * Return the taxonomy_term entity so it works like the default taxonomy entity
 */

function liberal_custom_content_metatag_route_entity(RouteMatchInterface $route_match) {
  if ($route_match->getRouteName() == 'view.oblation_microsite.page') {
    if ($tid = $route_match->getParameter('taxonomy_term')) {
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
      return $term;
    }
  }
}

