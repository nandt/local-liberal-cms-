<?php

declare(strict_types=1);

/**
 * @file
 * Install and update hooks for targeted configuration changes.
 */

use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Utility\UpdateException;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\jsonapi_extras\Entity\JsonapiResourceConfig;
use Drupal\search_api\IndexInterface;
use Drupal\views\ViewEntityInterface;

/**
 * Implements hook_install().
 *
 * Χωρίς αυτό, σε νέο περιβάλλον δεν εφαρμόζεται τίποτα από το module: το Drupal
 * γράφει το τελευταίο schema number κατευθείαν και προσπερνά τα update hooks.
 * Είναι όλα idempotent (ελέγχουν loadByName πριν δημιουργήσουν), οπότε τρέχουν
 * με ασφάλεια στη σειρά.
 */
function unicorn_config_updates_install(): void {
  _unicorn_config_updates_apply_all();
}

/**
 * Εφαρμόζει όλες τις config αλλαγές του module. Idempotent.
 *
 * Κάθε update ελέγχει loadByName πριν δημιουργήσει, οπότε ξανατρέχει με ασφάλεια.
 */
function _unicorn_config_updates_apply_all(): string {
  $logger = \Drupal::logger('unicorn_config_updates');
  $applied = [];
  foreach (['11001', '11002', '11003', '11004', '11006', '11008', '11009', '11010', '11011', '11012'] as $number) {
    $function = 'unicorn_config_updates_update_' . $number;
    try {
      $function();
      $applied[] = $number;
    }
    catch (\Throwable $e) {
      $logger->error('@update failed: @message', ['@update' => $number, '@message' => $e->getMessage()]);
    }
  }

  return 'Applied config updates: ' . (implode(', ', $applied) ?: 'none');
}

/**
 * Restrict Liberal Articles to one Category.
 */
function unicorn_config_updates_update_11001(): string {
  $field_storage = FieldStorageConfig::loadByName('node', 'field_liberal_category');

  if (!$field_storage) {
    throw new UpdateException('The node.field_liberal_category field storage does not exist.');
  }

  if ($field_storage->getCardinality() === 1) {
    return 'Liberal Category cardinality is already 1.';
  }

  $query = \Drupal::database()
    ->select('node__field_liberal_category', 'category')
    ->condition('deleted', 0)
    ->condition('delta', 0, '>');
  $query->addExpression('COUNT(DISTINCT category.entity_id)', 'article_count');
  $result = $query->execute();
  if (!$result) {
    throw new UpdateException('Unable to check Articles with more than one Category.');
  }
  $multi_category_articles = (int) $result->fetchField();

  if ($multi_category_articles > 0) {
    throw new UpdateException("$multi_category_articles Articles have more than one Category. Clean up the data before changing the cardinality.");
  }

  $field_storage
    ->setCardinality(1)
    ->save();

  return 'Liberal Category cardinality changed from unlimited to 1.';
}

/**
 * Update Hero Image requirements and add the Full-width Image field.
 */
function unicorn_config_updates_update_11002(): string {
  $hero_image = FieldConfig::loadByName('node', 'article_liberal', 'field_kentriki_fotografia');

  if (!$hero_image instanceof FieldConfig) {
    throw new UpdateException('The node.article_liberal.field_kentriki_fotografia field does not exist.');
  }

  $hero_settings = $hero_image->getSettings();
  $hero_settings['file_extensions'] = 'webp png jpg jpeg';
  $hero_settings['max_filesize'] = '4 MB';
  $hero_image->setSettings($hero_settings);
  $hero_image->save();

  $field_storage = FieldStorageConfig::loadByName('node', 'field_full_width_image');
  if (!$field_storage) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => 'field_full_width_image',
      'entity_type' => 'node',
      'type' => 'boolean',
      'cardinality' => 1,
      'translatable' => TRUE,
    ]);
    $field_storage->save();
  }
  elseif ($field_storage->getType() !== 'boolean' || $field_storage->getCardinality() !== 1) {
    throw new UpdateException('The node.field_full_width_image field storage has an unexpected definition.');
  }

  $field = FieldConfig::loadByName('node', 'article_liberal', 'field_full_width_image');
  if (!$field) {
    $field = FieldConfig::create([
      'field_name' => 'field_full_width_image',
      'entity_type' => 'node',
      'bundle' => 'article_liberal',
      'label' => 'Full-width Image',
      'description' => 'Display the Hero Image at the full width of the Article page.',
      'required' => FALSE,
      'translatable' => TRUE,
      'default_value' => [
        ['value' => 0],
      ],
      'settings' => [
        'on_label' => '1',
        'off_label' => '0',
      ],
    ]);
    $field->save();
  }

  $resource_config = \Drupal::entityTypeManager()
    ->getStorage('jsonapi_resource_config')
    ->load('node--article_liberal');
  if (!$resource_config instanceof JsonapiResourceConfig) {
    throw new UpdateException('The node--article_liberal JSON:API resource configuration does not exist.');
  }

  $resource_fields = (array) $resource_config->get('resourceFields');
  $resource_fields['field_full_width_image'] = [
    'disabled' => FALSE,
    'fieldName' => 'field_full_width_image',
    'publicName' => 'field_full_width_image',
    'enhancer' => ['id' => ''],
  ];
  $resource_config
    ->set('resourceFields', $resource_fields)
    ->save();

  return 'Hero Image requirements and Full-width Image field updated.';
}

/**
 * Add the Video Article fields and expose them on the Article form display.
 */
function unicorn_config_updates_update_11003(): string {
  $storages = [
    'field_vid_article_duration' => [
      'type' => 'decimal',
      'settings' => ['precision' => 10, 'scale' => 2],
    ],
    'field_vid_article_episode' => [
      'type' => 'integer',
      'settings' => ['unsigned' => FALSE, 'size' => 'normal'],
    ],
    'field_vid_article_height' => [
      'type' => 'decimal',
      'settings' => ['precision' => 10, 'scale' => 2],
    ],
    'field_vid_article_series' => [
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
    ],
    'field_vid_article_source_code' => [
      'type' => 'text_long',
      'settings' => [],
    ],
    'field_vid_article_width' => [
      'type' => 'decimal',
      'settings' => ['precision' => 10, 'scale' => 2],
    ],
  ];

  foreach ($storages as $field_name => $definition) {
    $field_storage = FieldStorageConfig::loadByName('node', $field_name);
    if (!$field_storage) {
      $field_storage = FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['settings'],
        'cardinality' => 1,
        'translatable' => TRUE,
      ]);
      $field_storage->save();
    }
    elseif ($field_storage->getType() !== $definition['type'] || $field_storage->getCardinality() !== 1) {
      throw new UpdateException("The node.$field_name field storage has an unexpected definition.");
    }
  }

  $vocabulary = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_vocabulary')
    ->load('series');
  if (!$vocabulary) {
    throw new UpdateException('The taxonomy.vocabulary.series vocabulary does not exist.');
  }

  $fields = [
    'field_vid_article_duration' => [
      'label' => 'Video Article Duration',
      'settings' => ['min' => NULL, 'max' => NULL, 'prefix' => '', 'suffix' => ''],
    ],
    'field_vid_article_episode' => [
      'label' => 'Video Article Episode',
      'settings' => ['min' => NULL, 'max' => NULL, 'prefix' => '', 'suffix' => ''],
    ],
    'field_vid_article_height' => [
      'label' => 'Video Article Height',
      'settings' => ['min' => NULL, 'max' => NULL, 'prefix' => '', 'suffix' => ''],
    ],
    'field_vid_article_series' => [
      'label' => 'Video Article Series',
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['series' => 'series'],
          'sort' => ['field' => 'name', 'direction' => 'asc'],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ],
    'field_vid_article_source_code' => [
      'label' => 'Video Article Source Code',
      'settings' => ['allowed_formats' => ['full_html']],
    ],
    'field_vid_article_width' => [
      'label' => 'Video Article Width',
      'settings' => ['min' => NULL, 'max' => NULL, 'prefix' => '', 'suffix' => ''],
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    $field = FieldConfig::loadByName('node', 'article_liberal', $field_name);
    if (!$field) {
      $field = FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'article_liberal',
        'label' => $definition['label'],
        'required' => FALSE,
        'translatable' => FALSE,
        'settings' => $definition['settings'],
      ]);
      $field->save();
    }
  }

  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.article_liberal.default');
  if (!$form_display instanceof EntityFormDisplayInterface) {
    throw new UpdateException('The node.article_liberal.default form display does not exist.');
  }

  $widgets = [
    'field_vid_article_source_code' => [
      'type' => 'text_textarea',
      'weight' => 200,
      'region' => 'content',
      'settings' => ['rows' => 5, 'placeholder' => ''],
    ],
    'field_vid_article_series' => [
      'type' => 'entity_reference_autocomplete',
      'weight' => 201,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ],
    'field_vid_article_episode' => [
      'type' => 'number',
      'weight' => 202,
      'region' => 'content',
      'settings' => ['placeholder' => ''],
    ],
    'field_vid_article_duration' => [
      'type' => 'number',
      'weight' => 203,
      'region' => 'content',
      'settings' => ['placeholder' => ''],
    ],
    'field_vid_article_width' => [
      'type' => 'number',
      'weight' => 204,
      'region' => 'content',
      'settings' => ['placeholder' => ''],
    ],
    'field_vid_article_height' => [
      'type' => 'number',
      'weight' => 205,
      'region' => 'content',
      'settings' => ['placeholder' => ''],
    ],
  ];

  foreach ($widgets as $field_name => $component) {
    $form_display->setComponent($field_name, $component);
  }
  $form_display->save();

  return 'Video Article fields added and exposed on the Article form display.';
