<?php

/**
 * @file
 * Ο index που χρειάζεται η ταξινόμηση κατά τίτλο.
 */

declare(strict_types=1);

/**
 * Το όνομα του index. Το πρόθεμα το βάζει το Drupal.
 */
const UNICORN_QO_TITLE_INDEX = 'unicorn_qo__title_nid';

/**
 * Φτιάχνει τον index αν λείπει.
 *
 * Ο υπάρχων node__title_type είναι prefix index (191 από τους 255 χαρακτήρες),
 * και ένα prefix index δεν μπορεί να εξυπηρετήσει ORDER BY — δύο τίτλοι που
 * διαφέρουν μετά τον 191ο χαρακτήρα έχουν ίδιο κλειδί, οπότε η σειρά δεν είναι
 * εγγυημένη. Η MariaDB το αρνείται ακόμα και με FORCE INDEX.
 *
 * Με πλήρες (title, nid) η ταξινόμηση πέφτει από 250 ms σε 0,1 ms.
 */
function _unicorn_query_optimizer_create_index(): string {
  $database = \Drupal::database();
  $table = $database->getPrefix() . 'node_field_data';

  $result = $database->query('SHOW INDEX FROM {node_field_data} WHERE Key_name = :name', [
    ':name' => UNICORN_QO_TITLE_INDEX,
  ]);
  if ($result !== NULL && $result->fetchAll()) {
    return 'Ο index υπάρχει ήδη.';
  }

  $started = microtime(TRUE);
  $database->query('CREATE INDEX ' . UNICORN_QO_TITLE_INDEX . " ON $table (title, nid)");

  return sprintf('Ο index δημιουργήθηκε σε %.1f s.', microtime(TRUE) - $started);
}

/**
 * Implements hook_install().
 */
function unicorn_query_optimizer_install(): void {
  \Drupal::logger('unicorn_query_optimizer')->notice(_unicorn_query_optimizer_create_index());
}

/**
 * Implements hook_uninstall().
 */
function unicorn_query_optimizer_uninstall(): void {
  $database = \Drupal::database();
  $table = $database->getPrefix() . 'node_field_data';

  $result = $database->query('SHOW INDEX FROM {node_field_data} WHERE Key_name = :name', [
    ':name' => UNICORN_QO_TITLE_INDEX,
  ]);
  if ($result !== NULL && $result->fetchAll()) {
    $database->query('DROP INDEX ' . UNICORN_QO_TITLE_INDEX . " ON $table");
  }
}

/**
 * Index για ταξινόμηση κατά τίτλο (LIBER-4480).
 */
function unicorn_query_optimizer_update_10001(): string {
  return _unicorn_query_optimizer_create_index();
}
